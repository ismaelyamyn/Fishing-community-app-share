# Copy to .env.local for your own computer (never commit .env.local).
# On Vercel, add the SAME names in Project Settings > Environment Variables.

# --- Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# the PUBLISHABLE key (sb_publishable_...) or the legacy anon key. NEVER the secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# the SECRET key (sb_secret_...) : server only, never starts with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# --- Mapbox: account.mapbox.com > Tokens (public token starting with pk.)
# after deployment, add a URL restriction for your live domain to this token
NEXT_PUBLIC_MAPBOX_TOKEN=pk.YOUR-TOKEN

# --- OpenWeatherMap (server only)
OPENWEATHER_API_KEY=

# --- Scheduled jobs: any long random string. The SAME value goes into the Supabase Vault
# (deploy/pgcron-hourly.sql). Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Live site address, no trailing slash. Leave empty on your own computer.
# Used in confirmation-email links. Example: https://my-app.vercel.app
NEXT_PUBLIC_SITE_URL=
